# Database (Set automatically by Replit)
DATABASE_URL=postgresql://user:password@localhost:5432/replit_db

# Twitter API v2 (Optional)
# Get your Bearer Token at: https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=AAAAAAAAAA...

# Telegram Bot (Optional, for future webhook integration)
# Create bot with @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdef...
TELEGRAM_WEBHOOK_URL=https://yourdomain.com/api/telegram-webhook
